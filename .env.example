# --- Admin panel ---
# Password for /admin (required for the admin panel to work)
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie.
# Optional — falls back to a derivation of ADMIN_PASSWORD when unset.
SESSION_SECRET=

# --- Upstash Redis (config persistence + lead storage) ---
# Create a free database at https://console.upstash.com and copy the REST values.
# When absent, the app runs with in-memory storage (fine for local dev;
# on Vercel, admin edits and leads won't persist between invocations).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
